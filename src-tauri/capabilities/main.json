{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local language workspace commands; Codex credentials remain managed by Codex.",
  "windows": ["main"],
  "permissions": [
    "allow-get-runtime-info",
    "allow-backend-profiles",
    "allow-backend-save-profile",
    "allow-backend-credential-status",
    "allow-backend-set-credential",
    "allow-backend-remove-credential",
    "allow-backend-models",
    "allow-backend-send",
    "allow-backend-stop",
    "allow-backend-disconnect",
    "allow-get-launch-options",
    "allow-companion-list",
    "allow-companion-select",
    "allow-companion-remove",
    "allow-claude-terminal-context",
    "allow-codex-connect",
    "allow-codex-disconnect",
    "allow-codex-status",
    "allow-codex-terminal-context",
    "allow-codex-login",
    "allow-codex-cancel-login",
    "allow-codex-open-login",
    "allow-codex-send",
    "allow-codex-stop",
    "allow-codex-reset",
    "allow-storage-load",
    "allow-storage-save",
    "allow-storage-create",
    "allow-storage-list",
    "allow-storage-read",
    "allow-storage-delete",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-destroy",
    "allow-vocabulary-list",
    "allow-vocabulary-get",
    "allow-vocabulary-save",
    "allow-vocabulary-add-occurrence",
    "allow-vocabulary-trash",
    "allow-vocabulary-restore",
    "allow-vocabulary-purge",
    "allow-vocabulary-save-draft",
    "allow-vocabulary-load-drafts",
    "allow-vocabulary-discard-draft",
    "allow-vocabulary-card-save",
    "allow-vocabulary-review-queue",
    "allow-vocabulary-review-grade",
    "allow-vocabulary-review-undo",
    "allow-vocabulary-tags-save",
    "allow-vocabulary-export",
    "allow-vocabulary-preview-import",
    "allow-vocabulary-import"
  ]
}
