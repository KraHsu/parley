{
  "name": "parley",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first language learning desktop client built with Vue and Tauri.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && cargo fmt --all -- --check && cargo clippy --workspace --all-targets --locked -- -D warnings",
    "doctor": "node scripts/doctor.mjs",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:check": "tauri build --debug --no-bundle"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "pinia": "4.0.3",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.8",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vue-tsc": "3.3.11"
  }
}
